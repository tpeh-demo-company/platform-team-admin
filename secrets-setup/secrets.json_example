[
  {
    "name": "PULUMI_ACCESS_TOKEN",
    "value": "your_pulumi_access_token",
    "note": "Pulumi API key"
  },
  {
    "name": "GITHUB_TOKEN",
    "value": "your_github_pat_token",
    "note": "GitHub Personal Access Token"
  },
  {
    "name": "GITHUB_OWNER",
    "value": "your_github_organization_name",
    "note": "GitHub organization or user name"
  },
  {
    "name": "APP_ID",
    "value": "your_tpeh_release_bot_app_id",
    "note": "GitHub App ID for tpeh-release-bot (found on the app settings page)"
  },
  {
    "name": "APP_PRIVATE_KEY",
    "value": "your_tpeh_release_bot_private_key_pem",
    "note": "GitHub App private key (.pem contents) for tpeh-release-bot"
  },
  {
    "name": "RELEASE_BOT_ID",
    "value": "your_tpeh_release_bot_id",
    "note": "The actual bot ID - gh api '/users/tpeh-release-bot[bot]' --jq .id"
  }
]
